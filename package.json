{
  "name": "portfolio-backend",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "npx @nestjs/cli build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npx @nestjs/cli start",
    "start:dev": "npx @nestjs/cli start --watch",
    "start:debug": "npx @nestjs/cli start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "oxlint --fix --fix-suggestions",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:cov": "vitest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e:setup": "docker compose --env-file .env.test up -d",
    "test:e2e": "vitest --config ./vitest.config.e2e.mts",
    "test:e2e:watch": "vitest --config ./vitest.config.e2e.mts --watch"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@nestjs/cli": "12.0.10",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^1000.0.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "zod-validation-error": "5.0.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "^1.16.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "@swc/core": true,
    "prisma": true,
    "fsevents@2.3.3": true
  }
}